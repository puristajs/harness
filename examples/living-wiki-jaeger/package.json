{
  "name": "@purista/living-wiki-jaeger-example",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run predev:api",
    "predev:api": "npm run build --workspace @purista/harness && npm run build --workspace @purista/harness-openai",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api:run\" \"npm:dev:web\"",
    "dev:api": "npm run dev:api:run",
    "dev:api:run": "tsx watch src/server.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --exclude 'dist/**' --exclude 'src/**/*.ui.test.tsx' && npm run test:ui",
    "test:ui": "vitest run src/**/*.ui.test.tsx --environment jsdom",
    "jaeger": "docker run --rm --name jaeger -p 16686:16686 -p 4317:4317 -p 4318:4318 -p 5778:5778 -p 9411:9411 cr.jaegertracing.io/jaegertracing/jaeger:2.17.0",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@purista/harness": "^3.0.0",
    "@purista/harness-openai": "^3.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ai-elements": "^1.9.0",
    "beautiful-mermaid": "^1.1.3",
    "hono": "^4.13.3",
    "json-renderer": "npm:@patrikstep/json-renderer@^3.1.3",
    "lucide-react": "^1.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
