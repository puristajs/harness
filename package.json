{
	"name": "@purista/agent-harness-repo",
	"version": "0.0.0",
	"private": true,
	"description": "Self-hosted enterprise agent harness.",
	"type": "module",
	"engines": {
		"node": ">=24.15.0"
	},
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"overrides": {
		"express-rate-limit": "^8.5.2",
		"@grpc/grpc-js": "^1.14.4"
	},
	"scripts": {
		"lint": "npm run lint --workspaces --if-present",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"test": "npm run test --workspaces --if-present",
		"test:coverage": "npm run test:coverage --workspaces --if-present",
		"test:contracts": "npm run test:contracts --workspace @purista/harness",
		"test:failure": "npm run test:failure --workspace @purista/harness",
		"test:integration": "npm run test:integration --workspace @purista/harness && npm run test --workspace @purista/quickstart",
		"test:types": "npm run test:types --workspace @purista/harness",
		"build": "npm run build --workspaces --if-present"
	},
	"allowScripts": {
		"esbuild@0.28.0": true,
		"node-liblzma": false,
		"protobufjs": false,
		"@mongodb-js/zstd": false,
		"fsevents": false
	}
}
