{
  "name": "@purista/harness-openai",
  "version": "2.1.0",
  "description": "OpenAI model provider adapter for @purista/harness.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/puristajs/harness",
    "directory": "packages/harness-openai"
  },
  "bugs": {
    "url": "https://github.com/puristajs/harness/issues"
  },
  "homepage": "https://github.com/puristajs/harness#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@purista/harness": "^2.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
