{
  "name": "@purista/harness-policy-opa",
  "version": "3.0.0",
  "description": "Typed Open Policy Agent Data API governance adapter for @purista/harness.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/puristajs/harness",
    "directory": "packages/harness-policy-opa"
  },
  "bugs": {
    "url": "https://github.com/puristajs/harness/issues"
  },
  "homepage": "https://purista.dev/handbook/harness/secure-and-govern/governance-policies/connect-external-policy-engine/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:types": "tsc -p tsconfig.type-tests.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@purista/harness": "^3.0.0"
  },
  "devDependencies": {
    "@purista/harness": "^3.0.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
