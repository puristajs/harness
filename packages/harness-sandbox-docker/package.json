{
  "name": "@purista/harness-sandbox-docker",
  "version": "3.0.0",
  "description": "Local Docker and OrbStack sandbox adapter for @purista/harness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist/**/*.js", "dist/**/*.d.ts", "image/Dockerfile", "image/.dockerignore", "image/smoke.sh", "image/README.md", "package.json", "README.md", "LICENSE"],
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": { "type": "git", "url": "https://github.com/puristajs/harness", "directory": "packages/harness-sandbox-docker" },
  "bugs": { "url": "https://github.com/puristajs/harness/issues" },
  "homepage": "https://github.com/puristajs/harness#readme",
  "publishConfig": { "access": "public" },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:docker": "PURISTA_DOCKER_SANDBOX_TEST=1 vitest run src/docker.test.ts",
    "test:image": "PURISTA_DOCKER_SANDBOX_TEST=1 vitest run src/image.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": { "zod": "^4.4.3" },
  "peerDependencies": { "@purista/harness": "^3.0.0" },
  "devDependencies": { "@types/node": "^26.2.0", "typescript": "npm:@typescript/typescript6@^6.0.2", "vitest": "^4.1.11" },
  "engines": { "node": ">=24.15.0" }
}
