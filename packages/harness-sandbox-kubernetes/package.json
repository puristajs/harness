{
  "name": "@purista/harness-sandbox-kubernetes",
  "version": "3.0.0",
  "description": "Self-hosted Kubernetes sandbox and durable workspace runtime for @purista/harness.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/puristajs/harness",
    "directory": "packages/harness-sandbox-kubernetes"
  },
  "bugs": {
    "url": "https://github.com/puristajs/harness/issues"
  },
  "homepage": "https://github.com/puristajs/harness#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc -p tsconfig.json",
    "lint": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run test-live"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@purista/harness": "^3.0.0",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
